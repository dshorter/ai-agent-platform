{
  "name": "Probabilistic Meta-Scheduler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 5 }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const roll = Math.random();\nlet out;\nif (roll <= 0.85) out = { scenario_name: 'routine_maintenance_day', event_count: 5 };\nelse if (roll <= 0.95) out = { scenario_name: 'winter_emergency_surge', event_count: 20 };\nelse out = { scenario_name: 'summer_heatwave', event_count: 25 };\nreturn [{ json: out }];"
      },
      "id": "dice-roll",
      "name": "Dice Roll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_EVENT_GENERATOR_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "id": "trigger-generator",
      "name": "Trigger Event Generator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Dice Roll", "type": "main", "index": 0 }]]
    },
    "Dice Roll": {
      "main": [[{ "node": "Trigger Event Generator", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": {}
}
